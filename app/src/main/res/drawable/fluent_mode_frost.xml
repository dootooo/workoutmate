<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="145"
                android:endColor="#08FFFFFF"
                android:startColor="#26FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.18"
                android:centerY="0.0"
                android:gradientRadius="180dp"
                android:startColor="#1FFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
